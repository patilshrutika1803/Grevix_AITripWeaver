# Backend: Supabase Auth and MongoDB
SUPABASE_URL=https://<your-supabase-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-public-anon-key>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=pack_go
PACK_GO_ALLOWED_ORIGINS=<your-frontend-origin>

# Frontend: Vite variables are public and bundled into browser assets.
VITE_SUPABASE_URL=https://<your-supabase-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-public-anon-key>
VITE_API_BASE_URL=https://<your-backend-host>

# Optional provider keys
GROQ_API_KEY=<your-groq-api-key>
GOOGLE_API_KEY=<your-google-api-key>
TAVILY_API_KEY=<your-tavily-api-key>
OPENWEATHERMAP_API_KEY=<your-openweathermap-api-key>
EXCHANGE_RATE_API_KEY=<your-exchange-rate-api-key>
ALPHAVANTAGE_API_KEY=<your-alphavantage-api-key>

# Optional persistent storage for vector memory and uploaded knowledge.
CHROMA_PERSIST_DIRECTORY=<path-to-chroma-storage>
RAG_STORAGE_DIRECTORY=<path-to-knowledge-storage>

# Operator-only: required only when granting admin access with scripts/create_admin.py.
SUPABASE_USER_ID=<existing-supabase-auth-uuid>
